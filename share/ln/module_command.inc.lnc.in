requires_version 0.2.43
# this include file can be customized with the following defines:
#   module_command_base
#     (optional) path to module-posix-timer-base-directory
#     e.g. /volume/software/common/packages/module_command/latest
#     or to a local reltool path,
#     or to a local install like: /home/schm_fl/workspace/module_command/build/sled11-x86-gcc4.x
#     defaults to rmpm structure

defines
module_command_base:          %(dirname %(dirname %(CURDIR)))
module_command_libdir:        %(subst "${exec_prefix}/", "", "@libdir@")
module_command_library_path:  %(module_command_base)/%(module_command_libdir)

ifndef rk_library_path: rk_library_path: ""
rk_library_path: %(rk_library_path):%(module_command_library_path)

